{
  "identifier": "default",
  "description": "悬浮条与设置窗口的最小权限集：核心默认集 + 拖动窗口（data-tauri-drag-region 走 plugin:window|start_dragging）+ 改悬浮条窗口尺寸（窗口尺寸档位走 plugin:window|set_size）+ 用户主题目录读写（plugin:fs，scope 收窄到 $APPDATA/themes）+ 打开主题文件夹（plugin:opener|open_path）",
  "windows": [
    "main",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA/themes",
        "$APPDATA/themes/**"
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        }
      ]
    }
  ]
}
